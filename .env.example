# ==========================================
# A1 Chicken Center - Environment Configuration
# ==========================================
# Copy this file to .env.local (for frontend) and .env (for backend)
# Never commit real credentials or secrets to git.

# ------------------------------------------
# Environment & Server
# ------------------------------------------
ENV=development
DEBUG=true
PORT=8000
HOST=0.0.0.0

# ------------------------------------------
# Frontend Configuration (Next.js)
# ------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# ------------------------------------------
# Backend CORS Configuration (FastAPI)
# ------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ------------------------------------------
# Supabase Configuration
# ------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-placeholder
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-placeholder
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-placeholder
